#!/usr/bin/env python3
"""Codex AGENTS.local.md overlay synchronizer."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any


BASE_NAME = "AGENTS.md"
LOCAL_NAME = "AGENTS.local.md"
OVERRIDE_NAME = "AGENTS.override.md"
STATE_VERSION = 1
MANAGED_MARKER = "Generated by codex-agents-local. Do not edit by hand."
DEFAULT_SKIP_DIRS = {".git"}


@dataclass
class Entry:
    directory: Path
    base_path: Path
    local_path: Path
    override_path: Path
    content: str
    digest: str
    wrote: bool
    blocked: bool
    warning: str | None


def eprint(message: str) -> None:
    print(message, file=sys.stderr)


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def sha256_path(path: Path) -> str:
    return hashlib.sha256(str(path).encode("utf-8")).hexdigest()


def read_text(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def write_text_if_changed(path: Path, content: str) -> bool:
    if path.exists() and path.is_file():
        try:
            if read_text(path) == content:
                return False
        except UnicodeDecodeError:
            pass
    path.write_text(content, encoding="utf-8")
    return True


def is_managed_override(path: Path) -> bool:
    if not path.is_file():
        return False
    try:
        return MANAGED_MARKER in read_text(path)
    except UnicodeDecodeError:
        return False


def find_git_root(cwd: Path) -> Path:
    try:
        result = subprocess.run(
            ["git", "-C", str(cwd), "rev-parse", "--show-toplevel"],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        root = result.stdout.strip()
        if root:
            return Path(root).resolve()
    except Exception:
        pass
    return cwd.resolve()


def resolve_root(cwd: Path, root: str | None) -> Path:
    if root:
        return Path(root).expanduser().resolve()
    return find_git_root(cwd)


def iter_dirs(root: Path) -> list[Path]:
    dirs: list[Path] = []
    for current, dirnames, _filenames in os.walk(root):
        dirnames[:] = sorted(name for name in dirnames if name not in DEFAULT_SKIP_DIRS)
        dirs.append(Path(current))
    return dirs


def build_override_content(directory: Path, base_path: Path, local_path: Path) -> str:
    base_text = read_text(base_path) if base_path.is_file() else ""
    local_text = read_text(local_path)
    source_parts: list[str] = []
    if base_path.is_file():
        source_parts.append(f"{BASE_NAME}=sha256:{sha256_text(base_text)}")
    source_parts.append(f"{LOCAL_NAME}=sha256:{sha256_text(local_text)}")

    body_parts: list[str] = [
        f"<!-- {MANAGED_MARKER} -->",
        f"<!-- Source directory: {directory} -->",
        f"<!-- Sources: {', '.join(source_parts)} -->",
        "",
    ]
    if base_text.strip():
        body_parts.extend(
            [
                f"<!-- BEGIN {BASE_NAME} -->",
                base_text.rstrip(),
                f"<!-- END {BASE_NAME} -->",
                "",
            ]
        )
    if local_text.strip():
        body_parts.extend(
            [
                f"<!-- BEGIN {LOCAL_NAME} -->",
                local_text.rstrip(),
                f"<!-- END {LOCAL_NAME} -->",
                "",
            ]
        )
    return "\n".join(body_parts)


def sync_tree(cwd: Path, root: str | None, write: bool) -> tuple[Path, list[Entry]]:
    root_path = resolve_root(cwd, root)
    entries: list[Entry] = []
    for directory in iter_dirs(root_path):
        local_path = directory / LOCAL_NAME
        if not local_path.is_file():
            continue
        base_path = directory / BASE_NAME
        override_path = directory / OVERRIDE_NAME
        content = build_override_content(directory, base_path, local_path)
        digest = sha256_text(content)
        blocked = override_path.exists() and not is_managed_override(override_path)
        warning = None
        if blocked:
            warning = (
                f"{override_path} already exists and is not managed by codex-agents-local; "
                f"leaving it untouched. Put local append-only guidance in {LOCAL_NAME}."
            )
        wrote = False if blocked else (write_text_if_changed(override_path, content) if write else False)
        entries.append(
            Entry(
                directory=directory,
                base_path=base_path,
                local_path=local_path,
                override_path=override_path,
                content=content,
                digest=digest,
                wrote=wrote,
                blocked=blocked,
                warning=warning,
            )
        )
    return root_path, entries


def aggregate_digest(entries: list[Entry]) -> str:
    payload = "\n".join(
        f"{entry.directory}:{entry.digest}:{entry.blocked}" for entry in sorted(entries, key=lambda item: str(item.directory))
    )
    return sha256_text(payload)


def codex_home() -> Path:
    return Path(os.environ.get("CODEX_HOME", "~/.codex")).expanduser()


def state_path() -> Path:
    return codex_home() / "tmp" / "codex-agents-local" / "state.json"


def load_state() -> dict[str, Any]:
    path = state_path()
    try:
        data = json.loads(read_text(path))
    except Exception:
        return {"version": STATE_VERSION, "roots": {}, "sessions": {}}
    if not isinstance(data, dict):
        return {"version": STATE_VERSION, "roots": {}, "sessions": {}}
    data.setdefault("version", STATE_VERSION)
    data.setdefault("roots", {})
    data.setdefault("sessions", {})
    return data


def save_state(state: dict[str, Any]) -> None:
    path = state_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def root_key(root: Path) -> str:
    return str(root.resolve())


def entry_state(entries: list[Entry]) -> dict[str, str]:
    return {str(entry.directory): f"{entry.digest}:{entry.blocked}" for entry in entries}


def entry_state_value(entry: Entry) -> str:
    return f"{entry.digest}:{entry.blocked}"


def update_startup_state(root: Path, entries: list[Entry]) -> None:
    state = load_state()
    state["roots"][root_key(root)] = {
        "digest": aggregate_digest(entries),
        "entries": entry_state(entries),
        "updated_at": int(time.time()),
    }
    save_state(state)


def hook_payload() -> dict[str, Any]:
    try:
        data = json.load(sys.stdin)
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def cwd_from_hook(data: dict[str, Any]) -> Path:
    raw = data.get("cwd")
    if isinstance(raw, str) and raw:
        return Path(raw).expanduser().resolve()
    tool_input = data.get("tool_input")
    if isinstance(tool_input, dict):
        raw = tool_input.get("cwd") or tool_input.get("workdir") or tool_input.get("working_dir")
        if isinstance(raw, str) and raw:
            return Path(raw).expanduser().resolve()
    return Path.cwd().resolve()


def session_id_from_hook(data: dict[str, Any]) -> str:
    value = data.get("session_id") or data.get("sessionId")
    return str(value) if value else "unknown-session"


def changed_entries_for_session(
    state: dict[str, Any],
    session_id: str,
    root: Path,
    entries: list[Entry],
) -> list[Entry]:
    root_name = root_key(root)
    sessions = state.setdefault("sessions", {})
    session = sessions.setdefault(session_id, {})
    session_roots = session.setdefault("roots", {})
    previous = session_roots.get(root_name)
    current_entries = entry_state(entries)

    if not isinstance(previous, dict):
        startup = state.get("roots", {}).get(root_name)
        if isinstance(startup, dict) and startup.get("entries") == current_entries:
            session_roots[root_name] = {
                "digest": aggregate_digest(entries),
                "entries": current_entries,
                "updated_at": int(time.time()),
            }
            return []
        return entries

    previous_entries = previous.get("entries")
    if not isinstance(previous_entries, dict):
        return entries
    return [entry for entry in entries if previous_entries.get(str(entry.directory)) != entry_state_value(entry)]


def mark_session_synced(
    state: dict[str, Any],
    session_id: str,
    root: Path,
    entries: list[Entry],
) -> None:
    root_name = root_key(root)
    session = state.setdefault("sessions", {}).setdefault(session_id, {})
    session_roots = session.setdefault("roots", {})
    session_roots[root_name] = {
        "digest": aggregate_digest(entries),
        "entries": entry_state(entries),
        "updated_at": int(time.time()),
    }


def build_additional_context(root: Path, entries: list[Entry]) -> str:
    parts = [
        "# AGENTS local sync update",
        "",
        "This update was generated by codex-agents-local and supersedes earlier AGENTS local sync update blocks for the same directories.",
        f"Workspace root: {root}",
        "",
    ]
    for entry in sorted(entries, key=lambda item: str(item.directory)):
        if entry.blocked:
            parts.extend(
                [
                    f"## Directory: {entry.directory}",
                    "",
                    f"Warning: {entry.warning}",
                    "",
                ]
            )
            continue
        parts.extend(
            [
                f"## Directory: {entry.directory}",
                "",
                "<INSTRUCTIONS>",
                entry.content.rstrip(),
                "</INSTRUCTIONS>",
                "",
            ]
        )
    return "\n".join(parts).rstrip()


def print_hook_continue() -> None:
    print(json.dumps({"continue": True, "suppressOutput": True}, separators=(",", ":")))


def hook_event_name(kind: str) -> str:
    return {
        "session-start": "SessionStart",
        "user-prompt-submit": "UserPromptSubmit",
        "pre-tool-use": "PreToolUse",
    }[kind]


def run_hook(kind: str, args: argparse.Namespace) -> int:
    data = hook_payload()
    cwd = Path(args.cwd).expanduser().resolve() if args.cwd else cwd_from_hook(data)
    root, entries = sync_tree(cwd, args.root, write=True)
    state = load_state()
    session_id = session_id_from_hook(data)
    changed = changed_entries_for_session(state, session_id, root, entries)
    mark_session_synced(state, session_id, root, entries)
    state["roots"][root_key(root)] = {
        "digest": aggregate_digest(entries),
        "entries": entry_state(entries),
        "updated_at": int(time.time()),
    }
    save_state(state)

    if not changed:
        print_hook_continue()
        return 0

    context = build_additional_context(root, changed)
    output = {
        "continue": True,
        "suppressOutput": True,
        "hookSpecificOutput": {
            "hookEventName": hook_event_name(kind),
            "additionalContext": context,
        },
    }
    print(json.dumps(output, ensure_ascii=False, separators=(",", ":")))
    return 0


def command_sync(args: argparse.Namespace) -> int:
    cwd = Path(args.cwd).expanduser().resolve()
    root, entries = sync_tree(cwd, args.root, write=not args.check)
    if args.mode == "startup" and not args.check:
        update_startup_state(root, entries)
    result = {
        "root": str(root),
        "entries": [
            {
                "directory": str(entry.directory),
                "override": str(entry.override_path),
                "digest": entry.digest,
                "wrote": entry.wrote,
                "blocked": entry.blocked,
                "warning": entry.warning,
            }
            for entry in entries
        ],
        "digest": aggregate_digest(entries),
    }
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        for entry in entries:
            status = "blocked" if entry.blocked else ("wrote" if entry.wrote else "ok")
            print(f"{status} {entry.override_path}")
            if entry.warning:
                eprint(f"warning: {entry.warning}")
        if not entries:
            print(f"no {LOCAL_NAME} files found under {root}")
    return 0


def command_install(args: argparse.Namespace) -> int:
    install_dir = Path(args.install_dir).expanduser()
    install_dir.mkdir(parents=True, exist_ok=True)
    source_root = Path(__file__).resolve().parents[1]

    target_cli = install_dir / "codex-agents-local"
    source_cli = source_root / "bin" / "codex-agents-local"
    if source_cli.resolve() != target_cli.resolve():
        shutil.copy2(source_cli, target_cli)
    target_cli.chmod(0o755)

    if args.hooks:
        install_hooks(
            str(target_cli),
            include_session_start=not args.no_session_start,
            include_pre_tool_use=args.pre_tool_use,
        )

    print(f"installed codex-agents-local to {target_cli}")
    if args.hooks:
        print("updated ~/.codex/hooks.json")
    return 0


def hook_group(command: str) -> dict[str, Any]:
    return {
        "hooks": [
            {
                "type": "command",
                "command": command,
                "timeout": 5,
                "async": False,
                "statusMessage": "AGENTS.local sync",
            }
        ]
    }


def ensure_hook(groups: list[Any], command: str) -> list[Any]:
    for group in groups:
        if not isinstance(group, dict):
            continue
        hooks = group.get("hooks")
        if not isinstance(hooks, list):
            continue
        for hook in hooks:
            if isinstance(hook, dict) and hook.get("command") == command:
                return groups
    groups.append(hook_group(command))
    return groups


def install_hooks(cli_path: str, include_session_start: bool, include_pre_tool_use: bool) -> None:
    hooks_file = codex_home() / "hooks.json"
    if hooks_file.exists():
        try:
            config = json.loads(read_text(hooks_file))
        except Exception:
            backup = hooks_file.with_suffix(".json.bak")
            shutil.copy2(hooks_file, backup)
            config = {}
    else:
        config = {}
    if not isinstance(config, dict):
        config = {}
    hooks = config.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        hooks = {}
        config["hooks"] = hooks

    user_cmd = f"{cli_path} hook user-prompt-submit"
    hooks["UserPromptSubmit"] = ensure_hook(
        hooks.get("UserPromptSubmit") if isinstance(hooks.get("UserPromptSubmit"), list) else [],
        user_cmd,
    )
    if include_session_start:
        session_cmd = f"{cli_path} hook session-start"
        hooks["SessionStart"] = ensure_hook(
            hooks.get("SessionStart") if isinstance(hooks.get("SessionStart"), list) else [],
            session_cmd,
        )
    if include_pre_tool_use:
        pre_cmd = f"{cli_path} hook pre-tool-use"
        hooks["PreToolUse"] = ensure_hook(
            hooks.get("PreToolUse") if isinstance(hooks.get("PreToolUse"), list) else [],
            pre_cmd,
        )

    hooks_file.parent.mkdir(parents=True, exist_ok=True)
    hooks_file.write_text(json.dumps(config, indent=2, sort_keys=False) + "\n", encoding="utf-8")


def command_doctor(_args: argparse.Namespace) -> int:
    print(f"codex home: {codex_home()}")
    print(f"state: {state_path()}")
    print(f"codex: {shutil.which('codex') or 'not found'}")
    print(f"git: {shutil.which('git') or 'not found'}")
    hooks_file = codex_home() / "hooks.json"
    print(f"hooks.json: {'present' if hooks_file.exists() else 'missing'}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Add AGENTS.local.md overlay support to Codex.")
    subparsers = parser.add_subparsers(dest="command", required=True)

    sync = subparsers.add_parser("sync", help="Generate AGENTS.override.md files under a workspace.")
    sync.add_argument("--cwd", default=".", help="Working directory used to discover the workspace root.")
    sync.add_argument("--root", help="Workspace root to scan. Defaults to git root, then cwd.")
    sync.add_argument("--check", action="store_true", help="Do not write files.")
    sync.add_argument("--json", action="store_true", help="Print JSON output.")
    sync.add_argument("--mode", choices=["manual", "startup"], default="manual")
    sync.set_defaults(func=command_sync)

    hook = subparsers.add_parser("hook", help="Run as a Codex hook command.")
    hook_sub = hook.add_subparsers(dest="hook_command", required=True)
    for name in ("session-start", "user-prompt-submit", "pre-tool-use"):
        sub = hook_sub.add_parser(name)
        sub.add_argument("--cwd", help="Override hook cwd.")
        sub.add_argument("--root", help="Workspace root to scan.")
        sub.set_defaults(func=lambda args, hook_name=name: run_hook(hook_name, args))

    install = subparsers.add_parser("install", help="Install CLI and hook config.")
    install.add_argument("--install-dir", default="~/.local/bin")
    install.add_argument("--hooks", action="store_true", help="Install Codex hooks.")
    install.add_argument("--no-session-start", action="store_true", help="Do not install the SessionStart hook.")
    install.add_argument("--pre-tool-use", action="store_true", help="Also install PreToolUse sync hook.")
    install.set_defaults(func=command_install)

    doctor = subparsers.add_parser("doctor", help="Show local installation diagnostics.")
    doctor.set_defaults(func=command_doctor)
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
